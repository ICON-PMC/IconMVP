# Copia este archivo a .env.local y rellena los valores.
# En local, obtén los valores con: supabase status

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (omite RLS) — para los cargadores de contenido del equipo. No usar NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (opcional). Las lee supabase/config.toml. Tras ponerlas: supabase stop && supabase start
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Cloudflare R2
NEXT_PUBLIC_R2_PUBLIC_BASE=
CLOUDFLARE_ACCOUNT_ID=
R2_S3_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
