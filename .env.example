# Copia este archivo a .env.local y pega los valores reales.
# Local: corre `supabase start` primero y toma Supabase URL / anon key / service_role de `supabase status`.
# Producción: pide las keys de R2 y la nube a quien lidera el proyecto (no se comparten en el repo).

# Supabase — local: valores fijos del CLI (iguales en toda instalación, no son secretos).
#            nube: ref oyzvuckkxzbufncvzcvw, keys distintas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — NUNCA exponer con prefijo NEXT_PUBLIC_. Usada por los cargadores de contenido (omite RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — entrega (público)
NEXT_PUBLIC_R2_PUBLIC_BASE=
# Cloudflare R2 — subida (solo servidor)
CLOUDFLARE_ACCOUNT_ID=
R2_S3_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Catálogo de marca vía Instagram (Meta Developers > tu app > Instagram > "API setup with
# Instagram login"). INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET son el "Instagram app ID" /
# "Instagram app secret" de ESA página — no el App ID genérico de Basic Settings, ese es
# para el flujo de Facebook Login, distinto. Ver HANDOFF.md para la guía paso a paso.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Debe ser EXACTAMENTE lo que registraste como redirect URI en "Business login settings"
# más /api/instagram/callback. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correo transaccional (aprobación/rechazo de marcas) — SMTP vía nodemailer.
# Local: Mailpit expone SMTP en 54325 (supabase/config.toml) y su bandeja en http://127.0.0.1:54324.
#        SMTP_HOST=127.0.0.1  SMTP_PORT=54325  (sin usuario/clave)
# Nube: usa las mismas credenciales SMTP que el proyecto Supabase (Auth → SMTP Settings).
# Los enlaces de los correos se arman con NEXT_PUBLIC_APP_URL (arriba); en Vercel debe ser la URL pública.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Icon <no-reply@tu-dominio.co>"
