# Copia este archivo a .env.local y pega los valores reales.
# Local: corre `supabase start` primero y toma Supabase URL / anon key / service_role de `supabase status`.
# Producción: pide las keys de R2 y la nube a la dueña del proyecto (no se comparten en el repo).

# Supabase — local: valores fijos del CLI (iguales en toda instalación, no son secretos).
#            nube: ref oyzvuckkxzbufncvzcvw, keys distintas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — NUNCA exponer con prefijo NEXT_PUBLIC_. Usada por los cargadores de contenido (omite RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — entrega (público)
NEXT_PUBLIC_R2_PUBLIC_BASE=
# Cloudflare R2 — subida (solo servidor)
CLOUDFLARE_ACCOUNT_ID=
R2_S3_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
